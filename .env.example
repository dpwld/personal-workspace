# Required in production. Choose your own random passphrase (at least 16 characters).
PASSCODE=
# Exact browser origin, no trailing slash. HTTPS for public deployments.
APP_ORIGIN=

# Optional hosted persistence. Set both values, or neither for local files.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Persistent filesystem directory for self-hosted local storage (default: .data).
WORKSPACE_DATA_DIR=

# Remote link previews are disabled by default. Comma-separated trusted HTTPS origins.
OG_ALLOWED_ORIGINS=

# Optional web push: generate your own key pair. Public value is embedded at build time.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Your own mailto: contact or HTTPS URL; no fallback sender.
VAPID_SUBJECT=
